Menu="SystemInformation"
Title="Storage Topology"
Icon="sitemap"
Tag="sitemap"
Markdown="false"
---
<?PHP
/* SAS storage topology: controller -> ports and connectors -> shelf I/O modules or expanders -> bays, with shelf power,
 * cooling and sensors, cable map, firmware, drives outside any bay, simple (USB / short-status) enclosures, and
 * per-drive link speed and errors mapped to Unraid disk names. Problems can be acknowledged (include/ack.php).
 * Data: scripts/collect.sh (read-only storcli/sg_ses/sysfs, cached 60 s), parsed by include/topology.php.
 */
$em = "$docroot/plugins/storage-topology";
require_once "$em/include/topology.php";
require_once "$em/include/common.php";
$maxAge = isset($_GET['refresh']) ? 5 : 60;
exec("timeout 100 $em/scripts/collect.sh $maxAge 2>&1", $out, $rc);
$m = topo_load();
if ($rc !== 0) array_unshift($m['problems'], ['level' => 'warn', 'text' => "Collector exit $rc - showing the last good data." . ($out ? ' ' . implode(' ', $out) : ''),
                                              'key' => 'collector-exit', 'value' => (string)$rc]);
st_acks_apply($m, 'storage');

$unitF = ($display['unit'] ?? 'C') === 'F';
$h = fn($s) => htmlspecialchars((string)$s, ENT_QUOTES);
$temp = fn($c) => $c === null ? '-' : ($unitF ? round($c * 9 / 5 + 32) . '&deg;F' : $c . '&deg;C');
$rate = fn($g) => $g ? rtrim(rtrim(number_format($g, 1), '0'), '.') . 'G' : '-';
$chip = fn($level, $text, $title = '') => "<span class='st-chip st-$level'" . ($title ? " title='" . htmlspecialchars($title, ENT_QUOTES) . "'" : '') . ">$text</span>";
$lvlText = ['ok' => 'Healthy', 'info' => 'Healthy (notes)', 'warn' => 'Warning', 'crit' => 'Critical'];
$diskLink = function ($d) use ($h) {
  if (!$d['unraid']) return $d['dev'] ? "<span class='st-dim'>{$h($d['dev'])}</span>" : '-';
  return "<a href='/Main/Device?name=" . urlencode($d['unraid']) . "'>{$h($d['unraid'])}</a>";
};
$age = $m['collected'] ? time() - $m['collected'] : null;
?>
<style>
.st-wrap{max-width:1500px}
.st-card{border:1px solid rgba(128,128,128,.3);border-radius:6px;padding:10px 14px;margin:12px 0}
.st-card h3{margin:0 0 6px 0;font-size:1.15em;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.st-card h4{margin:12px 0 4px 0;font-size:1em;opacity:.85}
table.st{width:100%;border-collapse:collapse;margin:4px 0}
table.st th{text-align:left;padding:4px 8px;border-bottom:1px solid rgba(128,128,128,.4);white-space:nowrap;font-weight:600}
table.st td{padding:4px 8px;border-bottom:1px solid rgba(128,128,128,.15);vertical-align:top}
table.st td.num{text-align:right;white-space:nowrap}
.st-chip{display:inline-block;padding:1px 8px;border-radius:10px;font-size:.88em;white-space:nowrap;border:1px solid currentColor}
.st-ok{color:#2e7d32}.st-info{color:#1e88e5}.st-warn{color:#e68a00}.st-crit{color:#d32f2f}.st-absent,.st-unknown,.st-dim{opacity:.55}
.st-kv{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:2px 18px;font-size:.95em}
.st-kv div span:first-child{opacity:.65;margin-right:6px}
.st-bays{display:grid;grid-template-columns:repeat(6,minmax(120px,1fr));gap:6px;margin:6px 0}
.st-bay{border:1px solid rgba(128,128,128,.35);border-left:4px solid rgba(128,128,128,.35);border-radius:4px;padding:4px 6px;font-size:.86em;line-height:1.35;min-height:62px}
.st-bay.ok{border-left-color:#2e7d32}.st-bay.info{border-left-color:#1e88e5}.st-bay.warn{border-left-color:#e68a00}.st-bay.crit{border-left-color:#d32f2f}.st-bay.empty{opacity:.45}
.st-bay b{font-size:1.05em}.st-bay .n{float:right;opacity:.6}
.st-sensors{display:flex;flex-wrap:wrap;gap:6px;margin:4px 0}
.st-problems{margin:6px 0 0 0;padding-left:18px}.st-problems li{margin:2px 0}
.st-flow{display:flex;flex-wrap:wrap;gap:6px;align-items:center;font-size:.95em}
.st-ack{margin-left:10px;font-size:.85em;opacity:.7}.st-acked{margin:4px 0 0 0}.st-acked summary{cursor:pointer}
tr.st-dim td{opacity:.55}
@media (max-width:900px){.st-bays{grid-template-columns:repeat(3,1fr)}}
</style>
<div class="st-wrap">
<p>
<?=$chip($m['level'] ?? 'ok', $lvlText[$m['level'] ?? 'ok'] ?? '')?>
<span class="st-dim">Collected <?=$age === null ? 'never' : ($age < 5 ? 'just now' : "{$age} s ago")?>
(<?=array_sum(array_column($m['timings'], 'ms'))?> ms, read-only storcli/sg_ses, cached 60 s).</span>
<a href="?refresh=1" style="margin-left:10px">Refresh</a>
<?=st_diag_html()?>
</p>
<?if ($m['no_sas']):?>
<p class="st-info">No SAS controllers found. This page is for SAS HBAs/RAID controllers and disk shelves<?=$m['enclosures'] ? '; ' . (array_filter(array_column($m['enclosures'], 'usb')) ? 'USB enclosures are' : 'enclosures are') . ' shown below.' : '.'?></p>
<?endif;?>
<?=st_problems_html($m, 'storage')?>

<?foreach ($m['controllers'] as $c):
  $cl = $c['status'] === 'Optimal' ? 'ok' : 'crit';
?>
<div class="st-card">
<h3><i class="fa fa-microchip"></i> <?=$h($c['model'])?> <span class="st-dim">c<?=$c['id']?></span> <?=$chip($cl, $h($c['status']))?></h3>
<div class="st-kv">
<?foreach (['Serial' => $c['serial'], ($c['fw_package'] !== '' ? 'Firmware package' : 'Firmware') => $c['fw_package'] !== '' ? "{$c['fw_package']} ({$c['fw']})" : $c['fw'],
             'BIOS' => $c['bios'], 'Driver' => $c['driver'], 'Mode' => $c['personality']] as $k => $v) if ((string)$v !== '') echo "<div><span>{$h($k)}</span>{$h($v)}</div>\n";?>
<?if ($c['roc_temp'] !== null):?><div><span>Chip temperature</span><?=$temp($c['roc_temp'])?></div>
<?endif;?>
<?foreach (['Cache memory' => $c['memory'], 'PCI' => $c['pci'], 'SAS address' => $c['sas'], 'storcli' => explode(' ', $c['cli'])[0]] as $k => $v) if ((string)$v !== '') echo "<div><span>{$h($k)}</span>{$h($v)}</div>\n";?>
</div>
<h4>Ports</h4>
<table class="st">
<tr><th>Port</th><th>PHYs</th><th>Width</th><th>Lane rates</th><th>Connectors</th><th>Attached to</th><th>Address</th></tr>
<?foreach ($c['ports'] as $p):
  $w = count($p['phys']);
  $expTip = $p['expect'] ? 'Expected ' . $rate($p['expect']) . ($p['remote_max'] ? " (this side up to {$rate($p['local_max'])}, far end up to {$rate($p['remote_max'])})" : '') : 'The far end does not report its maximum rate';
?>
<tr><td>Port <?=$p['port']?></td><td><?=implode(', ', $p['phys'])?></td>
<td><?=$chip($w < 4 && $p['expander'] ? 'warn' : 'ok', "x$w")?><?=$p['wide'] ? " <span class='st-dim'>wide port</span>" : ''?></td>
<td><?=$chip($p['slow'] ? 'warn' : 'ok', implode(' / ', array_map($rate, $p['rates'])), $expTip)?></td>
<td><?=$h(implode('+', $p['connectors']))?></td>
<td><?=$h($p['attached_label'])?> <span class="st-dim"><?=$h($p['type'])?></span></td><td class="st-dim"><?=$h($p['attached'])?></td></tr>
<?endforeach;?>
</table>
<?if ($c['connectors']):
  $unused = [];
  foreach ($c['connectors'] as $g) {
    $free = array_values(array_diff($g['phys'], array_keys($g['linked'])));
    if (!$free) continue;
    $unused[] = count($free) === count($g['phys']) ? "{$g['label']} ({$g['phy_text']})" : "{$g['label']} PHY " . implode(', ', $free);
  }
?>
<h4>Connectors</h4>
<table class="st">
<tr><th>Connector</th><th>PHYs</th><th>Lanes linked</th><th>Lane rates</th><th>Ports</th><th>Attached to</th></tr>
<?foreach ($c['connectors'] as $g): if (!$g['linked']) continue;?>
<tr><td><b><?=$h($g['label'])?></b></td><td><?=$h(implode(', ', $g['phys']))?></td>
<td><?=$chip($g['level'], count($g['linked']) . ' of ' . count($g['phys']), $g['partial'] ? 'Partially linked: check the cable and connector' : '')?></td>
<td><?=implode(' / ', array_map($rate, $g['linked']))?></td><td><?=$h(implode(', ', array_map(fn($x) => "Port $x", $g['ports'])))?></td>
<td><?=$h(implode('; ', $g['attached']))?></td></tr>
<?endforeach;?>
<?if ($unused):?><tr><td colspan="6" class="st-dim"><?=$c['unused_phys']?> PHYs not connected: <?=$h(implode(', ', $unused))?>.</td></tr><?endif;?>
</table>
<p class="st-dim" style="margin:2px 0">Connectors are derived (4 PHYs per connector, counted from PHY 0) and may not match the labels on the card.<?=
  $c['connector_names'] ? ' storcli reports the enclosures on ' . $h(implode('; ', array_map(fn($e, $n) => "$e: $n", array_keys($c['connector_names']), $c['connector_names']))) . '.' : ''?></p>
<?endif;?>
</div>
<?endforeach;?>

<?if ($m['direct']):?>
<div class="st-card">
<h3><i class="fa fa-hdd-o"></i> Directly attached drives <span class="st-dim">not in any enclosure bay</span></h3>
<table class="st">
<tr><th>Port</th><th>Disk</th><th>Device</th><th>Model</th><th>Size</th><th>Temp</th><th>Link</th><th></th></tr>
<?foreach ($m['direct'] as $x): $d = $m['drives'][$x['drive']];?>
<tr><td><?=$h($x['where'])?></td><td><?=$diskLink($d)?><?=$d['unraid_type'] ? " <span class='st-dim'>{$h($d['unraid_type'])}</span>" : ''?></td><td><?=$h($d['dev'])?></td>
<td><?=$h($d['model'])?> <span class="st-dim"><?=$h($d['intf'])?></span></td><td class="num"><?=$h($d['size'])?></td><td class="num"><?=$temp($d['temp'])?></td>
<td><?=$d['rate'] ? $chip($d['max_rate'] && $d['rate'] < $d['max_rate'] ? 'info' : 'ok', $rate($d['rate']) . ($d['max_rate'] ? ' of ' . $rate($d['max_rate']) : '')) : '-'?></td>
<td class="st-dim"><?=$h($x['note'])?></td></tr>
<?endforeach;?>
</table>
</div>
<?endif;?>

<?if ($m['cables']):?>
<div class="st-card">
<h3><i class="fa fa-plug"></i> Cables</h3>
<table class="st">
<tr><th>From</th><th></th><th>To</th><th>Cable</th><th>Serial</th><th>Status</th></tr>
<?foreach ($m['cables'] as $cb):?>
<tr><td><?=$h($cb['local'])?></td><td>&harr;</td><td><?=$h($cb['remote'])?></td><td><?=$h($cb['cable'])?></td><td class="st-dim"><?=$h($cb['sn'])?></td>
<td><?=$chip(topo_worst($cb['levels']), $h($cb['status']))?></td></tr>
<?endforeach;?>
</table>
<p class="st-dim" style="margin:4px 0 0 0">From the shelves' SES connector data. IOM A/B and port numbers follow the SES element order.</p>
</div>
<?endif;?>

<?foreach ($m['shelves'] as $s):
  $g = $s['groups'];
  $levels = [$s['level']];
  foreach (['psu', 'fan', 'temp', 'volt', 'amp', 'conn', 'esc'] as $k) foreach ($g[$k] as $x) $levels[] = $x['level'];
  foreach ($g['fan'] as $x) if ($x['level'] === 'ok' && !empty($x['flags'])) $levels[] = 'warn';
  // Sensors grouped by subenclosure (EMC: LCC A, LCC B, chassis, PSU A, PSU B) when the enclosure has several.
  $bySub = function (array $xs, callable $one) use ($s, $h) {
    if (!$s['sub_names']) return implode('', array_map($one, $xs));
    $out = []; $groups = [];
    foreach ($xs as $x) $groups[$x['sub'] ?? -1][] = $x;
    foreach ($groups as $sub => $list) $out[] = "<span class='st-dim'>" . $h($s['sub_names'][$sub] ?? "Subenclosure $sub") . ':</span> ' . implode('', array_map($one, $list));
    return implode(" <span class='st-dim'>&middot;</span> ", $out);
  };
  foreach ($s['ioms'] as $i) $levels[] = $i['level'];
  $sl = topo_worst(array_intersect($levels, ['ok', 'warn', 'crit']));
  $drives = $s['drives'];
  $paired = count($g['psu']) && count($g['fan']) == 2 * count($g['psu']) && count($g['volt']) == 2 * count($g['psu']) && count($g['amp']) == 2 * count($g['psu']);
?>
<div class="st-card">
<h3><i class="fa fa-server"></i> <?=$h($s['label'])?> <span class="st-dim"><?=$h("{$s['vendor']} {$s['product']}")?></span> <?=$chip($sl, $lvlText[$sl])?>
<span class="st-dim" style="font-size:.8em"><?=implode(' &middot; ', array_filter([$s['eid'] !== null ? "storcli e{$s['eid']}" : '', 'SES ' . $h(implode(', ', $s['sg'])),
  $s['serial'] !== '' ? 'SN ' . $h($s['serial']) : '', count($drives) . ' drives']))?></span>
<?=$s['fault_explained'] ? "<span class='st-{$s['level']}' style='font-size:.85em'>(shelf fault LED on)</span>" : ''?></h3>

<?if ($s['ioms']):?>
<h4>I/O modules</h4>
<table class="st">
<tr><th>Module</th><th>Status</th><th>Firmware</th><th>Part</th><th>Serial</th><th>Expander address</th></tr>
<?foreach ($s['ioms'] as $i):?>
<tr><td><?=$h($i['name'])?></td><td><?=$chip($i['level'], $h($i['status']))?></td><td><b><?=$h($i['fw'])?></b></td><td><?=$h($i['pn'])?></td><td><?=$h($i['serial'])?></td><td class="st-dim"><?=$h($i['sas'])?></td></tr>
<?endforeach;?>
</table>
<?endif;?>

<?$psuIn = array_filter($g['psu'], fn($x) => $x['level'] !== 'absent');
if ($g['psu'] || $g['fan'] || $g['volt'] || $g['amp']):?>
<h4>Power and cooling</h4>
<?if ($psuIn):?>
<table class="st">
<tr><th>PSU</th><th>Status</th><th>Firmware</th><th>Part</th><th>Serial</th><th>Rating</th><?if ($paired):?><th>Fans</th><th>Voltages</th><th>Currents</th><?endif;?></tr>
<?foreach ($g['psu'] as $n => $x):?>
<tr<?=$x['level'] === 'absent' ? ' class="st-dim"' : ''?>><td><?=$x['name'] !== '' ? $h(topo_short_name($x['name'])) : 'PSU ' . ($n + 1)?></td><td><?=$chip($x['level'], $h($x['status']) . ($x['flags'] ? ' (' . $h(implode(', ', $x['flags'])) . ')' : ''))?></td>
<td><?=$h($x['fw'])?></td><td><?=$h($x['pn'])?></td><td><?=$h($x['kv']['SN'] ?? '')?></td><td><?=isset($x['kv']['PW']) ? $h($x['kv']['PW']) . ' W' : ''?></td>
<?if ($paired):?>
<td><?foreach ([2 * $n, 2 * $n + 1] as $f) echo $chip($g['fan'][$f]['level'], $g['fan'][$f]['rpm'] . ' rpm', $g['fan'][$f]['code']) . ' ';?></td>
<td><?foreach ([2 * $n, 2 * $n + 1] as $f) echo $chip($g['volt'][$f]['level'], number_format($g['volt'][$f]['value'], 2) . ' V') . ' ';?></td>
<td><?foreach ([2 * $n, 2 * $n + 1] as $f) echo $chip($g['amp'][$f]['level'], number_format($g['amp'][$f]['value'], 2) . ' A') . ' ';?></td>
<?endif;?>
</tr>
<?endforeach;?>
</table>
<?endif;?>
<?if ($paired && $psuIn):?><p class="st-dim" style="margin:2px 0">Fans, voltages and currents are shown two per PSU, in SES sensor order.</p>
<?else:?>
<div class="st-sensors">
<?if (!$psuIn) foreach ($g['psu'] as $x) echo $chip($x['level'], ($x['name'] !== '' ? $h(topo_short_name($x['name'])) : 'PSU ' . ($x['n'] + 1)) . ': ' . $h($x['status']));?>
<?=$bySub($g['fan'], fn($x) => $chip($x['level'] === 'ok' && !empty($x['flags']) ? 'warn' : $x['level'], ($x['name'] !== '' ? $h(topo_short_name($x['name'])) : 'Fan ' . ($x['n'] + 1)) . ': ' . ($x['level'] === 'absent' ? 'not installed' : (int)$x['rpm'] . ' rpm') . ($x['flags'] && $x['level'] !== 'absent' ? ' (' . $h(implode(', ', $x['flags'])) . ')' : ''), $x['code']) . ' ')?>
<?foreach ($g['volt'] as $x) echo $chip($x['level'], 'V' . ($x['n'] + 1) . ': ' . ($x['value'] === null ? 'n/a' : number_format($x['value'], 2) . ' V'));?>
<?foreach ($g['amp'] as $x) echo $chip($x['level'], 'I' . ($x['n'] + 1) . ': ' . ($x['value'] === null ? 'n/a' : number_format($x['value'], 2) . ' A'));?>
</div>
<?endif;?>
<?endif;?>

<?if ($g['temp']):?>
<h4>Temperatures <?php $tv = array_filter(array_column($g['temp'], 'value'), fn($v) => $v !== null); if ($tv):?><span class="st-dim">max <?=$temp(max($tv))?></span><?endif;?></h4>
<div class="st-sensors">
<?=$bySub($g['temp'], fn($x) => $chip($x['flags'] ? 'warn' : $x['level'], ($x['name'] !== '' ? $h($x['name']) : 'T' . ($x['n'] + 1)) . ' ' . $temp($x['value']), $x['desc'] ?: '') . ' ')?>
</div>
<?endif;?>

<h4>Bays</h4>
<div class="st-bays">
<?foreach ($g['slot'] as $x):
  $d = $drives[$x['slot']] ?? null;
  // Which fault bit lights the bay's fault LED: sensed by the shelf (a problem), or requested by host software (info).
  $faultTip = !empty($x['fault_sensed']) ? "\nFault LED: the shelf reports a fault (fault sensed)"
    : (!empty($x['fault_reqstd']) ? "\nFault LED: turned on by host software (fault requested), not a shelf-detected fault. Clear with: {$x['clear_cmd']}" : '');
  $faultTag = !empty($x['fault_sensed']) ? "<span class='st-warn' title='The shelf reports a fault in this bay (fault sensed)'>fault sensed</span>"
    : (!empty($x['fault_reqstd']) ? "<span class='st-info' title='Fault LED turned on by host software (fault requested), not a shelf-detected fault'>fault LED by host</span>" : '');
  if (!$d) {
    $cls = $x['level'] === 'absent' ? 'empty' : ($x['level'] === 'ok' ? 'warn' : $x['level']);
    if (!empty($x['fault_sensed']) && $cls === 'empty') $cls = 'warn';
    echo "<div class='st-bay $cls'" . ($faultTip ? " title='{$h(ltrim($faultTip))}'" : '') . "><span class='n'>{$x['slot']}</span>"
      . ($x['level'] === 'absent' ? 'empty' : $h($x['status']) . '<br><span class="st-dim">no disk linked to this bay</span>') . ($faultTag ? "<br>$faultTag" : '') . '</div>';
    continue;
  }
  $dl = topo_worst(array_filter([
    ($d['smart_alert'] || (int)$d['pred_fail'] > 0 || ($d['state'] !== '' && !in_array($d['state'], ['Onln', 'JBOD', 'UGood'], true))) ? 'crit' : null,
    ((int)$d['media_err'] > 0 || !empty($x['fault_sensed']) || in_array($x['level'], ['warn', 'crit'], true)) ? 'warn' : null,
    ((int)$d['other_err'] > 0 || !empty($x['fault_reqstd']) || ($d['max_rate'] && $d['rate'] < $d['max_rate'])) ? 'info' : null,
  ]));
  $tip = "{$d['vendor']} {$d['model']} SN {$d['serial']} FW {$d['fw']}\n{$d['size']} {$d['intf']} {$d['state']}\nSES: {$x['status']}" . ($x['ident'] ? ' (locate LED on)' : '') . $faultTip;
?>
<div class="st-bay <?=$dl?>" title="<?=$h($tip)?>"><span class="n"><?=$x['slot']?></span>
<b><?=$diskLink($d)?></b><?=$d['dev'] && $d['unraid'] ? " <span class='st-dim'>{$h($d['dev'])}</span>" : ''?><br>
<span class="st-dim"><?=$h($d['size'])?> <?=$h($d['model'])?></span><br>
<?=$temp($d['temp'])?> &middot; <?=$rate($d['rate'])?><?=$d['max_rate'] && $d['rate'] < $d['max_rate'] ? "<span class='st-dim'>/{$rate($d['max_rate'])}</span>" : ''?>
<?=(int)$d['other_err'] || (int)$d['media_err'] ? " &middot; <span class='st-warn'>err {$d['media_err']}/{$d['other_err']}</span>" : ''?>
<?=$faultTag ? "<br>$faultTag" : ''?>
</div>
<?endforeach;?>
</div>

<?if ($drives):?>
<details><summary>Drive details (<?=count($drives)?>)</summary>
<table class="st">
<tr><th>Bay</th><th>Disk</th><th>Device</th><th>Model</th><th>Serial</th><th>FW</th><th>Size</th><th>Temp</th><th>Link</th><th>Paths</th><th>Media err</th><th>Other err</th><th>Pred. fail</th><th>SMART</th></tr>
<?foreach ($drives as $d):?>
<tr><td><?=$d['slot']?></td><td><?=$diskLink($d)?><?=$d['unraid_type'] ? " <span class='st-dim'>{$h($d['unraid_type'])}</span>" : ''?></td><td><?=$h($d['dev'])?></td>
<td><?=$h($d['model'])?></td><td><?=$h($d['serial'])?></td><td><?=$h($d['fw'])?></td><td class="num"><?=$h($d['size'])?></td><td class="num"><?=$temp($d['temp'])?></td>
<td><?=$chip($d['max_rate'] && $d['rate'] < $d['max_rate'] ? 'info' : 'ok', $rate($d['rate']) . ($d['max_rate'] ? ' of ' . $rate($d['max_rate']) : ''))?></td>
<td><?foreach ($d['paths'] as $p) echo $chip($p['status'] === 'Active' ? 'ok' : 'warn', "P{$p['port']} {$rate($p['rate'])}", $p['sas']) . ' ';?></td>
<td class="num <?=(int)$d['media_err'] ? 'st-warn' : ''?>"><?=$d['media_err'] ?? '-'?></td><td class="num <?=(int)$d['other_err'] ? 'st-info' : ''?>"><?=$d['other_err'] ?? '-'?></td>
<td class="num <?=(int)$d['pred_fail'] ? 'st-crit' : ''?>"><?=$d['pred_fail'] ?? '-'?></td><td><?=$d['smart_alert'] ? $chip('crit', 'alert') : $chip('ok', 'ok')?></td></tr>
<?endforeach;?>
</table>
</details>
<?endif;?>
</div>
<?endforeach;?>

<?// Firmware overview: everything that has a version, with differences called out.
$fw = [];
foreach ($m['controllers'] as $c) $fw['Controller'][$c['fw_package'] . " ({$c['fw']})"][] = "{$c['model']} c{$c['id']}";
foreach ($m['shelves'] as $s) {
  foreach ($s['ioms'] as $i) $fw['Shelf I/O modules'][$i['fw']][] = "{$s['label']} {$i['name']}";
  // PSU firmware is specific to the PSU's hardware revision, so compare versions per part number: different
  // revisions on different firmware is normal, and only the same part on different versions is a mismatch.
  foreach ($s['groups']['psu'] as $n => $x) if ($x['fw'] !== '')
    $fw[trim('Shelf PSUs ' . trim((string)($x['pn'] ?? '')))][$x['fw']][] = "{$s['label']} " . ($x['name'] !== '' ? topo_short_name($x['name']) : 'PSU ' . ($n + 1));
}
foreach ($m['drives'] as $d) if ($d['fw']) $fw["Drives: {$d['model']}"][$d['fw']][] = $d['unraid'] ?: ($d['dev'] ?: "e{$d['eid']}/s{$d['slot']}");
?>
<?if ($fw):?>
<div class="st-card">
<h3><i class="fa fa-code-fork"></i> Firmware</h3>
<table class="st">
<tr><th>Component</th><th>Versions</th></tr>
<?foreach ($fw as $what => $vers):?>
<tr><td><?=$h($what)?></td><td><?foreach ($vers as $v => $who) echo $chip(count($vers) > 1 ? 'warn' : 'ok', $h($v) . ' &times;' . count($who), implode(', ', $who)) . ' ';?></td></tr>
<?endforeach;?>
</table>
<p class="st-dim" style="margin:4px 0 0 0">Amber means the same part runs different versions. Hover a version to see where it runs.</p>
</div>
<?endif;?>

<?foreach ($m['other_ses'] as $o): $g = $o['groups'];?>
<div class="st-card">
<h3><i class="fa fa-hdd-o"></i> <?=$h("{$o['vendor']} {$o['product']}")?> <span class="st-dim">SES <?=$h($o['sg'])?>, firmware <?=$h($o['rev'])?></span>
<?=$chip(topo_worst(array_intersect(array_merge(array_column($g['temp'], 'level'), array_column($g['fan'], 'level'), array_column($g['psu'], 'level')), ['ok', 'warn', 'crit'])), 'status')?></h3>
<div class="st-sensors">
<?foreach ($g['temp'] as $x) echo $chip($x['level'], $h($x['desc'] ?: 'Temp ' . ($x['n'] + 1)) . ': ' . $temp($x['value']) . ($x['flags'] ? ' (' . $h(implode(', ', $x['flags'])) . ')' : ''));?>
<?foreach ($g['fan'] as $x) echo $chip($x['level'], $h($x['desc'] ?: 'Fan ' . ($x['n'] + 1)) . ': ' . ($x['rpm'] ? $x['rpm'] . ' rpm' : $h($x['status'])));?>
<?foreach ($g['volt'] as $x) echo $chip($x['level'], $h($x['desc'] ?: 'Voltage ' . ($x['n'] + 1)) . ': ' . ($x['value'] === null ? 'no reading' : number_format($x['value'], 2) . ' V'));?>
</div>
<p class="st-dim" style="margin:4px 0 0 0">This card's own report lists <?=count(array_filter($g['slot'], fn($x) => $x['level'] === 'ok'))?> of <?=count($g['slot'])?> slots as occupied.
It does not track every slot, so check Main for the drives themselves. Its voltage readings (0xFFFF) are shown as "no reading" and not counted as problems; temperature and fan come from the card as reported.</p>
</div>
<?endforeach;?>

<?foreach ($m['enclosures'] as $e):?>
<div class="st-card">
<h3><i class="fa fa-<?=$e['usb'] ? 'usb' : 'hdd-o'?>"></i> <?=$e['usb'] ? 'USB enclosure' : 'Enclosure'?>: <?=$h($e['name'])?>
<?=$e['disks'] ? '<span>(' . $h(implode(', ', array_map(fn($d) => $d['dev'] . ($d['unraid'] ? " → {$d['unraid']}" : ''), $e['disks']))) . ')</span>' : ''?>
<span class="st-dim"><?=$h(trim("SES {$e['sg']}, {$e['vendor']} {$e['product']}") . ($e['rev'] !== '' ? ", firmware {$e['rev']}" : '') . ($e['driver'] ? ", {$e['driver']}" : ''))?></span>
<?=$chip($e['level'] === 'unknown' ? 'unknown' : $e['level'], $h($e['status_text'] ?: 'unknown'), $e['status'] ? sprintf('Short enclosure status byte 0x%02x', $e['status']['byte']) : '')?></h3>
<?if ($e['short_status_only']):?>
<p class="st-dim" style="margin:2px 0">Supports only the short status page: overall status only, no per-bay, fan or PSU detail.</p>
<?elseif ($e['groups']): $g = $e['groups'];?>
<div class="st-sensors">
<?foreach ($g['temp'] as $x) echo $chip($x['level'], $h($x['desc'] ?: 'Temp ' . ($x['n'] + 1)) . ': ' . $temp($x['value']));?>
<?foreach ($g['fan'] as $x) echo $chip($x['level'], $h($x['desc'] ?: 'Fan ' . ($x['n'] + 1)) . ': ' . ($x['rpm'] ? $x['rpm'] . ' rpm' : $h($x['status'])));?>
<?foreach ($g['psu'] as $x) echo $chip($x['level'], $h($x['desc'] ?: 'PSU ' . ($x['n'] + 1)) . ': ' . $h($x['status']));?>
</div>
<?endif;?>
<?if ($e['disks']):?>
<table class="st">
<tr><th></th><th>Disk</th><th>Device</th><th>Model</th><th>Size</th><th>Temp</th></tr>
<?foreach ($e['disks'] as $d):?>
<tr><td class="st-dim"><?=$h($d['where'])?></td><td><?=$diskLink($d)?><?=$d['unraid_type'] ? " <span class='st-dim'>{$h($d['unraid_type'])}</span>" : ''?></td><td><?=$h($d['dev'])?></td>
<td><?=$h($d['model'])?></td><td class="num"><?=$h($d['size'])?></td><td class="num"><?=$temp($d['temp'])?></td></tr>
<?endforeach;?>
</table>
<?if ($e['disk_source'] === 'host'):?><p class="st-dim" style="margin:2px 0">No bay data: these are the disks on the same SCSI host, which may include drives outside this enclosure.</p><?endif;?>
<?else:?>
<p class="st-dim" style="margin:2px 0">No bay data.</p>
<?endif;?>
</div>
<?endforeach;?>

<p class="st-dim">Cache: <code>/var/local/storage-topology/current</code>. Timings: <?=$h(implode(', ', array_map(fn($k, $t) => "$k {$t['ms']} ms", array_keys($m['timings']), $m['timings'])))?>.</p>
</div>
<?=st_problems_js($var['csrf_token'] ?? '')?>
