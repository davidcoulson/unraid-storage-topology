<?PHP
/* PCI topology: root complexes -> root ports -> switches -> devices, with link speed/width at both ends, drivers,
 * IOMMU groups, VM passthrough, SR-IOV, AER, ASPM and resizable BARs; CPU layout (sockets, NUMA nodes, CCDs/CCXs,
 * isolated CPUs, VM pinning) and memory (channels, DIMMs, ECC counters, hugepages).
 * Data: scripts/collect-pci.sh (read-only lspci/dmidecode/sysfs/proc, cached 60 s), parsed by include/pci.php.
 */
$em = "$docroot/plugins/storage-topology";
require_once "$em/include/pci.php";
require_once "$em/include/common.php";
$maxAge = isset($_GET['refresh']) ? 5 : 60;
exec("timeout 60 $em/scripts/collect-pci.sh $maxAge 2>&1", $out, $rc);
$m = pci_load(getenv('ST_PCI_DIR') ?: PCI_CACHE);
if ($rc !== 0) array_unshift($m['problems'], ['level' => 'warn', 'text' => "Collector exit $rc - showing the last good data." . ($out ? ' ' . implode(' ', $out) : ''), 'who' => '',
                                              'key' => 'collector-exit', 'value' => (string)$rc]);
st_acks_apply($m, 'pci');

$h = fn($s) => htmlspecialchars((string)$s, ENT_QUOTES);
$chip = fn($level, $text, $title = '') => "<span class='st-chip st-$level'" . ($title !== '' ? " title='" . htmlspecialchars($title, ENT_QUOTES) . "'" : '') . ">$text</span>";
$lvlText = ['ok' => 'Healthy', 'info' => 'Healthy (notes)', 'warn' => 'Warning', 'crit' => 'Critical'];
$levelFor = fn(array $who) => pci_worst(array_column(array_filter($m['problems'], fn($p) => in_array($p['who'] ?? '', $who, true)), 'level'));
$age = $m['collected'] ? time() - $m['collected'] : null;
$cpu = $m['cpu'];
$mem = $m['mem'];
$dev = $m['devices'];
$iso = array_flip($cpu['isolated'] ?? []);
$multiNode = count($cpu['nodes'] ?? []) > 1;
// Which VM each CPU is pinned to (running VMs first).
$vmOf = [];
foreach ($m['vms'] as $name => $vm) foreach ($vm['pins'] as $set) foreach (pci_cpus($set) as $c) $vmOf[$c][] = $name . ($vm['running'] ? '' : ' (stopped)');
// Device interrupts per CPU (host drivers only).
$irqsOn = [];
foreach ($dev as $d) if ($d['driver'] !== 'vfio-pci') foreach ($d['irq_cpus'] as $c) $irqsOn[$c][] = $d['bdf'];
$roleText = ['root port' => 'Root port', 'switch upstream' => 'Switch', 'switch port' => 'Switch port', 'host bridge' => 'Host bridge', 'bridge' => 'Bridge', 'endpoint' => ''];
$name = fn($d) => preg_replace('/\s*\[[0-9a-f]{4}(:[0-9a-f]{4})?\]/', '', $d['short']);
$linkCell = function ($d) use ($h, $chip, $dev) {
  $l = $d['link'];
  if ($l === null) return $d['max_speed'] !== null && !$d['children'] && in_array($d['role'], ['root port', 'switch port'], true)
    ? "<span class='st-dim'>empty (max " . pci_link_text($d['max_speed'], $d['max_width']) . ')</span>' : '';
  if (isset($l['shared'])) return "<span class='st-dim'>same link as " . $h(substr($l['shared'], 5)) . '</span>';
  $lvl = $l['narrow'] ? 'warn' : ($l['slow'] ? (str_starts_with($d['class'], '0x03') || in_array($d['power'], ['D3hot', 'D3cold'], true) ? 'info' : 'warn') : 'ok');
  $tip = sprintf("Current: %s GT/s x%s%s\nDevice supports: %s GT/s x%s\nPort %s supports: %s GT/s x%s", $l['cur_speed'], $l['cur_width'],
    $l['gbs'] ? sprintf(' (%.1f GB/s)', $l['gbs']) : '', $l['dev_speed'], $l['dev_width'], $l['port'], $l['port_speed'], $l['port_width']);
  return $chip($lvl, $h(pci_link_text($l['cur_speed'], $l['cur_width'])), $tip)
    . " <span class='st-dim'>of " . $h(pci_link_text($l['exp_speed'], $l['exp_width'])) . '</span>'
    . ($l['dev_speed'] != $l['port_speed'] || $l['dev_width'] != $l['port_width']
      ? "<br><span class='st-dim' style='font-size:.85em'>dev " . $h(pci_link_text($l['dev_speed'], $l['dev_width'])) . ' / port ' . $h(pci_link_text($l['port_speed'], $l['port_width'])) . '</span>' : '');
};
$detailChips = function ($d) use ($h, $chip, $m, $dev) {
  $out = [];
  if ($d['slot'] !== '') $out[] = $chip('dim', 'slot ' . $h($d['slot']));
  if ($d['vms']) foreach ($d['vms'] as $v) $out[] = $chip(($m['vms'][$v]['running'] ?? false) ? 'ok' : 'dim', 'VM ' . $h($v), ($m['vms'][$v]['running'] ?? false) ? 'Passed through to this running VM' : 'Passed through to this VM (stopped)');
  elseif ($d['vfio_boot']) $out[] = $chip('dim', 'vfio at boot', 'Bound to vfio-pci at boot (System Devices, /boot/config/vfio-pci.cfg)');
  if ($d['role'] === 'switch upstream' && $d['link'] && !isset($d['link']['shared'])) {
    // Fan-out: lanes behind the switch against the lanes into it. Ports to the switch's own functions (a management
    // endpoint, a chipset's SATA and USB controllers: same vendor as the switch) are internal and left out.
    $down = array_filter(array_map(fn($c) => $dev[$c], $d['children']), fn($c) => $c['role'] === 'switch port'
      && !array_filter($c['children'], fn($k) => $dev[$k]['vendor_id'] === $d['vendor_id']));
    $lanes = array_sum(array_map(fn($c) => (int)$c['max_width'], $down));
    $up = (int)$d['link']['exp_width'];
    if ($lanes && $up) $out[] = $chip('dim', count($down) . ' ports, ' . $lanes . ':' . $up . ' lanes', count($down) . " downstream ports with $lanes lanes in all share the x$up link into the switch"
      . ($lanes > $up ? sprintf(' (%.1f:1 oversubscribed when every port is busy at once)', $lanes / $up) : '') . '.');
  }
  if ($d['sriov']) $out[] = $chip($d['sriov']['num'] ? 'ok' : 'dim', "SR-IOV {$d['sriov']['num']}/{$d['sriov']['total']} VFs");
  if ($d['physfn']) $out[] = $chip('dim', 'VF of ' . $h(substr($d['physfn'], 5)));
  foreach ($d['rebar'] as $n => $r) if ($r['max_bytes'] && $r['max_bytes'] > 256 << 20) $out[] = $chip($r['cur_bytes'] >= $r['max_bytes'] ? 'ok' : 'dim', "ReBAR $n: " . $h($r['current']),
    "Resizable BAR $n: " . $r['current'] . ' of up to ' . $r['max'] . ($r['cur_bytes'] < $r['max_bytes'] ? ' (not at its largest size: Above 4G decoding / Resizable BAR may be off in the BIOS, or the driver chose it)' : ''));
  if ($d['aspm'] !== '' && $d['link'] && !isset($d['link']['shared'])) $out[] = $chip('dim', 'ASPM ' . $h(strtolower($d['aspm']) === 'disabled' ? 'off' : $d['aspm']), 'Active State Power Management. Link supports: ' . ($d['aspm_cap'] ?: '-')
    . "\nThe kernel policy (pcie_aspm.policy) applies to all links.");
  foreach (['fatal' => 'crit', 'nonfatal' => 'warn', 'cor' => 'info'] as $k => $lvl) if (($d['aer'][$k]['total'] ?? 0) > 0)
    $out[] = $chip($lvl, 'AER ' . ['fatal' => 'fatal', 'nonfatal' => 'non-fatal', 'cor' => 'corrected'][$k] . ' ' . number_format($d['aer'][$k]['total']),
      implode("\n", array_map(fn($n, $v) => "$n: $v", array_keys($d['aer'][$k]['detail']), $d['aer'][$k]['detail'])));
  if ($d['lane_err'] !== '') $out[] = $chip('dim', 'lane errors', "The link's lane error status register has lanes " . $d['lane_err'] . " flagged (sticky, often set once during link training; not counted as a problem).");
  if (in_array($d['power'], ['D3hot', 'D3cold'], true)) $out[] = $chip('dim', $h($d['power']), 'Device is in a low-power state');
  if ($d['irqs']) $out[] = $chip('dim', count($d['irqs']) . ' IRQ' . (count($d['irqs']) === 1 ? '' : 's'), 'Interrupts handled on CPUs ' . (pci_cpulist($d['irq_cpus']) ?: '-'));
  return implode(' ', $out);
};
// Tree rows, depth first. Filler host bridges (AMD "Dummy Host Bridge", data fabric) get a class the toggle hides.
$rows = function (array $list, int $depth, string $prefix) use (&$rows, $dev): array {
  $out = [];
  $n = count($list);
  foreach (array_values($list) as $i => $b) {
    $d = $dev[$b];
    $last = $i === $n - 1;
    $out[] = ['d' => $d, 'depth' => $depth, 'tree' => $depth ? $prefix . ($last ? '└─ ' : '├─ ') : ''];
    if ($d['children']) $out = array_merge($out, $rows($d['children'], $depth + 1, $depth ? $prefix . ($last ? '   ' : '│  ') : ''));
  }
  return $out;
};
?>
<style>
